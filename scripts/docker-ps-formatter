#!/usr/bin/env python3
"""
Formats 'docker ps' output into a transposed table with columns per container.
Rows: CONTAINER ID, STATUS, PORTS (full mapping, vertical).
Columns: each container's name as header, with its values below.

Ports are displayed as they appear in 'docker ps' (e.g., 0.0.0.0:3306->3306/tcp),
one per line.

Usage:
    docker ps | ./docker-ps-formatter
    ./docker-ps-formatter               # runs 'docker ps' automatically
    ./docker-ps-formatter /path/to/file # reads from file
"""

import sys
import subprocess
import re

# Maximum width for a single port line (truncate with ellipsis if longer)
MAX_PORT_WIDTH = 80

def get_docker_ps_lines():
    """Return list of lines from docker ps (including header)."""
    if len(sys.argv) > 1:
        with open(sys.argv[1], 'r') as f:
            return f.read().splitlines()
    elif not sys.stdin.isatty():
        return sys.stdin.read().splitlines()
    else:
        try:
            result = subprocess.run(['docker', 'ps'], capture_output=True, text=True, check=True)
            return result.stdout.splitlines()
        except subprocess.CalledProcessError as e:
            print("Error running docker ps:", e.stderr, file=sys.stderr)
            sys.exit(1)

def parse_docker_ps(lines):
    """Parse default docker ps output. Returns list of dicts with keys: id, image, ports, names, status."""
    if not lines:
        return []
    header = lines[0]

    # Determine column start positions based on header
    col_starts = {}
    headers = ['CONTAINER ID', 'IMAGE', 'COMMAND', 'CREATED', 'STATUS', 'PORTS', 'NAMES']
    for h in headers:
        idx = header.find(h)
        if idx != -1:
            col_starts[h] = idx

    needed = ['CONTAINER ID', 'IMAGE', 'STATUS', 'PORTS', 'NAMES']
    for n in needed:
        if n not in col_starts:
            print(f"Warning: Could not find column '{n}' in docker ps output", file=sys.stderr)
            return []

    # Sort columns by start position to get column order
    sorted_cols = sorted(col_starts.items(), key=lambda x: x[1])

    containers = []
    for line in lines[1:]:
        if not line.strip():
            continue
        data = {}
        # Extract each needed column
        for i, (col_name, start) in enumerate(sorted_cols):
            # For the last column (NAMES), take everything from start to end of line
            if col_name == 'NAMES':
                value = line[start:].strip()
            else:
                # For other columns, find the end as the start of the next column
                if i + 1 < len(sorted_cols):
                    next_start = sorted_cols[i+1][1]
                    value = line[start:next_start].strip()
                else:
                    # Should not happen for non-last columns, but fallback
                    value = line[start:].strip()
            data[col_name] = value
        containers.append({
            'id': data.get('CONTAINER ID', ''),
            'image': data.get('IMAGE', ''),
            'status': data.get('STATUS', ''),
            'ports': data.get('PORTS', ''),
            'names': data.get('NAMES', '')
        })
    return containers

def split_port_mappings(ports_str):
    """
    Convert the raw ports string into a list of individual mapping lines.
    Preserves the exact format as it appears in 'docker ps' (e.g., '0.0.0.0:3306->3306/tcp').
    Each entry is stripped and truncated if needed.
    """
    if not ports_str:
        return ['-']
    # Split by comma and strip whitespace
    parts = [p.strip() for p in ports_str.split(',')]
    # Remove any empty strings
    parts = [p for p in parts if p]
    if not parts:
        return ['-']
    # Truncate each line if too long
    truncated = []
    for p in parts:
        if len(p) > MAX_PORT_WIDTH:
            p = p[:MAX_PORT_WIDTH - 3] + "..."
        truncated.append(p)
    return truncated

def format_transposed(containers):
    """Print a transposed table with multiline PORTS cells showing full mappings."""
    if not containers:
        print("No containers found.")
        return

    # Prepare container names for header
    container_names = [c['names'] for c in containers]

    # Build attribute rows: CONTAINER ID, STATUS, PORTS
    attribute_rows = [
        ('CONTAINER ID', [c['id'][:12] for c in containers]),           # single-line
        ('STATUS', [c['status'] for c in containers]),                  # single-line
        ('PORTS', [split_port_mappings(c['ports']) for c in containers]) # multiline
    ]

    # Compute column widths
    # First column (attribute names) width
    first_col_width = max(len(attr[0]) for attr in attribute_rows)

    # For each container column, width = max(container_name, longest line in any cell)
    num_containers = len(containers)
    col_widths = []
    for j in range(num_containers):
        max_len = len(container_names[j])
        for attr_name, cells in attribute_rows:
            cell = cells[j]
            if isinstance(cell, list):
                # multiline: find longest line
                for line in cell:
                    max_len = max(max_len, len(line))
            else:
                max_len = max(max_len, len(cell))
        col_widths.append(max_len)

    # Helper to print a padded row with optional multiline cells
    def print_multiline_row(first_cell, cells):
        # first_cell is a string (attribute name), cells is a list of cells (each string or list)
        # Convert all cells to lists of lines for uniform processing
        line_lists = []
        max_lines = 0
        for cell in cells:
            if isinstance(cell, list):
                line_lists.append(cell)
                max_lines = max(max_lines, len(cell))
            else:
                line_lists.append([cell])
                max_lines = max(max_lines, 1)

        # Print each line
        for line_idx in range(max_lines):
            # First column: first line gets attribute name, subsequent lines are empty
            if line_idx == 0:
                row = first_cell.ljust(first_col_width)
            else:
                row = " " * first_col_width

            # For each container column, print the line if it exists, else empty string
            for j in range(num_containers):
                cell_lines = line_lists[j]
                if line_idx < len(cell_lines):
                    content = cell_lines[line_idx]
                else:
                    content = ""
                row += "  " + content.ljust(col_widths[j])
            print(row)

    # Print header row: empty first cell, then container names (single-line)
    header_line = " " * first_col_width
    for j, name in enumerate(container_names):
        header_line += "  " + name.ljust(col_widths[j])
    print(header_line)

    # Print separator
    sep = "-" * first_col_width
    for w in col_widths:
        sep += "--" + "-" * w
    print(sep)

    # Print each attribute row in the defined order
    for attr_name, cells in attribute_rows:
        print_multiline_row(attr_name, cells)

def main():
    lines = get_docker_ps_lines()
    containers = parse_docker_ps(lines)
    format_transposed(containers)

if __name__ == "__main__":
    main()
